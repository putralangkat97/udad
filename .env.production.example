APP_NAME="Wedding Invitation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://wedding-adis.anggit.dev

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wedding
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer

CACHE_STORE=redis
CACHE_PREFIX=wedding-cache
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

FILESYSTEM_DISK=public
